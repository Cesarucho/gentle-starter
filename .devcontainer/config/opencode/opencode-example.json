{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "model": "openai/gpt-6.1-sol",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "variant": "low"
    }
  },
  "default_agent": "gentle-orchestrator",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "servers": {
      "codegraph": {
        "codemode": false,
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "environment": {
          "CODEGRAPH_NO_DOWNLOAD": "1",
          "CODEGRAPH_NO_UPDATE_CHECK": "1",
          "CODEGRAPH_TELEMETRY": "0"
        },
        "type": "local"
      },
      "engram": {
        "command": [
          "/usr/local/bin/engram",
          "mcp",
          "--tools=agent"
        ],
        "enabled": true,
        "type": "local"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/home/ubuntu/**"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "*.env"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "*.env.*"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": ".env.d/**"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": ".env.d"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.engram"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gentle-ai"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gitconfig-volume"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gentle-shell"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.config/opencode"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.local/share/opencode"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.pi"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.ssh"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.ssh-server"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.engram/**"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gentle-ai/**"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gitconfig-volume/**"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gitconfig"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.gentle-shell/**"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": ".codegraph/**"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": ".codegraph"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "*/.codegraph"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "*/.codegraph/**"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "/home/ubuntu/.config/opencode/**"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.local/share/opencode/**"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.pi/**"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.ssh/**"
    },
    {
      "action": "*",
      "effect": "ask",
      "resource": "/home/ubuntu/.ssh-server/**"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": ".devcontainer/.env"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": ".devcontainer/.env"
    },
    {
      "action": "*",
      "effect": "deny",
      "resource": "*.git-credentials"
    },
    {
      "action": "*",
      "effect": "deny",
      "resource": "*auth.json"
    },
    {
      "action": "*",
      "effect": "allow",
      "resource": "/tmp/**"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "@mohak34/opencode-notifier@latest"
  ],
  "share": "disabled"
}
