{
  "packages": [
    "npm:gentle-pi@2.2.0",
    "npm:pi-subagents@0.54.0",
    "npm:pi-intercom@0.11.0",
    "npm:gentle-engram@0.1.10",
    "npm:pi-web-access@0.24.1",
    "npm:pi-lens@4.1.1",
    "npm:@juicesharp/rpiv-todo@1.20.0",
    "npm:@juicesharp/rpiv-ask-user-question@1.20.0",
    "npm:@juicesharp/rpiv-btw@1.20.0",
    "npm:pi-mcp-adapter",
    "npm:pi-terminal-theme@0.2.0"
  ],
  "lastChangelogVersion": "0.80.2",
  "theme": "terminal-tinted",
  "defaultProvider": "opencode-go",
  "defaultModel": "minimax-m3",
  "defaultThinkingLevel": "medium",
  "terminal": {
    "showTerminalProgress": true
  },
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "low"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai-codex/gpt-5.3-codex-spark",
        "thinking": "high"
      }
    }
  },
  "hud": {
    "mode": "overlay",
    "position": "top-right",
    "shortcut": "ctrl+shift+h",
    "switchShortcut": "ctrl+.",
    "minimizeShortcut": "ctrl+h",
    "autoCompactWhileStreaming": true,
    "startupNotification": true,
    "usageDisplay": "metered",
    "contextIndicator": "icon",
    "expandedWidth": 42,
    "compactWidth": 26,
    "minTerminalWidth": 90,
    "margin": {
      "top": 1,
      "right": 1,
      "bottom": 1
    },
    "visibility": {
      "context": true,
      "project": true,
      "worktrees": true,
      "mcps": true
    }
  },
  "header-info": true,
  "footer": true,
  "breadcrumb": "inner"
}