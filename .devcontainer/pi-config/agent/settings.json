{
  "packages": [
    "npm:gentle-pi@0.4.5",
    "npm:pi-subagents@0.28.0",
    "npm:pi-intercom@0.6.0",
    "npm:gentle-engram@0.1.7",
    "npm:pi-web-access@0.10.7",
    "npm:pi-lens@3.8.50",
    "npm:@juicesharp/rpiv-todo@1.18.2",
    "npm:@juicesharp/rpiv-ask-user-question@1.18.2",
    "npm:pi-terminal-theme@0.2.0",
    "npm:pi-mcp-adapter@2.9.0",
    "npm:pi-hud@0.8.0",
    "npm:pi-powerline@0.7.1",
    "npm:@juicesharp/rpiv-btw@1.18.2"
  ],
  "lastChangelogVersion":"0.78.1",
  "theme":"terminal-tinted",
  "defaultProvider":"openai-codex",
  "defaultModel":"gpt-5.5",
  "defaultThinkingLevel":"medium",
  "terminal":{
    "showTerminalProgress":true
  },
  "subagents":{
    "agentOverrides":{
      "context-builder":{
        "model":"opencode-go/deepseek-v4-pro",
        "thinking":"medium"
      },
      "delegate":{
        "model":"openai-codex/gpt-5.4",
        "thinking":"medium"
      },
      "oracle":{
        "model":"openai-codex/gpt-5.5",
        "thinking":"medium"
      },
      "planner":{
        "model":"openai-codex/gpt-5.5",
        "thinking":"medium"
      },
      "researcher":{
        "model":"opencode-go/deepseek-v4-pro",
        "thinking":"high"
      },
      "reviewer":{
        "model":"opencode-go/deepseek-v4-pro",
        "thinking":"high"
      },
      "scout":{
        "model":"opencode-go/deepseek-v4-pro",
        "thinking":"medium"
      },
      "worker":{
        "model":"openai-codex/gpt-5.3-codex-spark",
        "thinking":"high"
      }
    }
  },
  "hud":{
    "mode":"overlay",
    "position":"top-right",
    "shortcut":"ctrl+shift+h",
    "switchShortcut":"ctrl+.",
    "minimizeShortcut":"ctrl+h",
    "autoCompactWhileStreaming":true,
    "startupNotification":true,
    "usageDisplay":"metered",
    "contextIndicator":"icon",
    "expandedWidth":42,
    "compactWidth":26,
    "minTerminalWidth":90,
    "margin":{
      "top":1,
      "right":1,
      "bottom":1
    },
    "visibility":{
      "context":true,
      "project":true,
      "worktrees":true,
      "mcps":true
    }
  },
  "powerline":true,
  "header-info":true,
  "footer":true,
  "breadcrumb":"inner"
}