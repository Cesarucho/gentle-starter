{
  "version": 1,
  "trees": [
    {
      "name": "OpenCode",
      "runtime": ".config/opencode",
      "seed": ".devcontainer/opencode-config",
      "managed": [
        "AGENTS.md",
        "opencode.json",
        "opencode-non-sdd.json",
        "opencode-notifier.json",
        "tui.json",
        ".gentle-ai-default-agent.json",
        "commands/**",
        "plugins/**",
        "profiles/**",
        "prompts/**",
        "skills/**"
      ],
      "excluded": [
        "opencode.jsonc",
        ".gentle-ai-telemetry-runtime.json",
        "**/.git/**",
        ".gitignore",
        "**/node_modules/**",
        "package.json",
        "package-lock.json",
        "**/profile-versions/**",
        "**/auth.json",
        "**/credentials.json",
        "**/sessions/**",
        "**/state/**",
        "**/logs/**",
        "**/cache/**",
        "**/caches/**"
      ]
    },
    {
      "name": "Pi Coding",
      "owner": "3030-ai-pi-coding.sh",
      "runtime": ".pi/agent",
      "seed": ".devcontainer/pi-config/agent",
      "managed": [
        "settings.json",
        "mcp.json",
        "mcp.presets.json",
        "subagents.json"
      ],
      "excluded": [
        "npm/**",
        "state/**",
        "sessions/**",
        "intercom/**",
        "bin/**",
        "chains/**",
        "agents/**",
        "gentle-ai/**",
        "pi-pretty/**",
        "auth.json",
        "trust.json",
        "APPEND_SYSTEM.md",
        "models-store.json",
        "mcp-cache.json",
        "mcp-npx-cache.json",
        "mcp.json.devcontainer-backup.*",
        "run-history.jsonl",
        "logs/**",
        "pids/**",
        "cache/**",
        "caches/**"
      ]
    },
    {
      "name": "Pi Gentle",
      "owner": "3040-ai-pi-gentle.sh",
      "runtime": ".pi/gentle-ai",
      "seed": ".devcontainer/pi-config/gentle-ai",
      "managed": [
        "banner.json",
        "models.json",
        "models.openai.json",
        "models.opencode.json",
        "persona.json"
      ],
      "excluded": [
        "auth.json",
        "credentials.json",
        "sessions/**",
        "state/**",
        "npm/**",
        "intercom/**",
        "run-history.jsonl",
        "logs/**",
        "pids/**",
        "cache/**",
        "caches/**"
      ]
    }
  ]
}
