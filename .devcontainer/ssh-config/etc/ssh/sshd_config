# sshd_config — hardened for devcontainer use
# Seeded by 20-tool-ssh.sh during DEVCONTAINER_PHASE=runtime.
# This file is idempotent: copy-on-first-run via seed_config_tree.

Port 22
ListenAddress 0.0.0.0

# Host keys — stored in ~/.ssh-server/ssh/ (persists across rebuilds)
HostKey /home/ubuntu/.ssh-server/ssh/ssh_host_rsa_key
HostKey /home/ubuntu/.ssh-server/ssh/ssh_host_ed25519_key

# Security defaults
PermitRootLogin no
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
KerberosAuthentication no
GSSAPIAuthentication no

# Auth
PubkeyAuthentication yes
AuthorizedKeysFile  .ssh/authorized_keys

# Logging
SyslogFacility AUTH
LogLevel INFO

# Session
ClientAliveInterval 120
ClientAliveCountMax 3
TCPKeepAlive yes

# Disable unused subsystems
Subsystem sftp /usr/lib/openssh/sftp-server
