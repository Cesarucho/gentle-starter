{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/schemas/gentle-starter.verified-payload-v1.schema.json",
  "title": "Gentle Starter verified payload",
  "type": "object",
  "required": [
    "schema",
    "source",
    "release",
    "immutable_identities",
    "manifest",
    "payload",
    "verification",
    "evidence",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "gentle-starter.verified-payload/v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "immutable_identities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/immutableIdentity"
      }
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "adapterId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*/v[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "source": {
      "type": "object",
      "required": [
        "adapter_id",
        "source_id"
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/adapterId"
        },
        "source_id": {
          "$ref": "#/$defs/sha256Id"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "id",
        "version",
        "predecessor_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256Id"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "predecessor_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "immutableIdentity": {
      "type": "object",
      "required": [
        "role",
        "id"
      ],
      "properties": {
        "role": {
          "enum": [
            "release",
            "content"
          ]
        },
        "id": {
          "$ref": "#/$defs/sha256Id"
        }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "starter-manifest/v1"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "payloadEntry": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "root",
        "entries"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/relativePath"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/payloadEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "result",
        "policy_id",
        "policy_sha256",
        "signer_subject_id"
      ],
      "properties": {
        "result": {
          "const": "accepted"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signer_subject_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "adapter_id",
        "ref",
        "sha256"
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/adapterId"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonicalization",
        "envelope_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "jq-sorted-utf8-v1"
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
