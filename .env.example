# Gentle Starter local environment template
#
# Copy this file to `.env` and uncomment only the variables you want to
# customize for your machine/project:
#
#   cp .env.example .env
#
# `.env` is intentionally ignored by Git. Keep real tokens, credentials, and
# machine-local values out of versioned files.
#
# Notes:
# - Commented values document the repository/tool defaults.
# - Build-time variables affect image creation only when passed as Docker build
#   args by the compose/devcontainer configuration.
# - Runtime variables are loaded into the container through `.devcontainer/docker-compose.yml`.

# ==============================================================================
# Pi / Gentle AI
# ==============================================================================

# Set to 1/true/yes to run `pi update` during post-create setup.
# Default: 0
# PI_AUTO_UPDATE=0

# Optional override for Pi's agent runtime/config directory.
# Default: ~/.pi/agent
# PI_CODING_AGENT_DIR=/home/ubuntu/.pi/agent

# Optional override for Pi session storage.
# Default: tool-defined under the Pi agent directory; overridden by `pi --session-dir`.
# PI_CODING_AGENT_SESSION_DIR=/home/ubuntu/.pi/agent/sessions

# Optional override for Pi package install/cache directory.
# Default: tool-defined under the Pi agent directory.
# PI_PACKAGE_DIR=/home/ubuntu/.pi/agent/npm

# Disable Pi startup network operations: update checks, package update checks,
# and install/update telemetry.
# Default: unset/disabled
# PI_OFFLINE=1

# Skip only the Pi version update check at startup.
# Default: unset/disabled
# PI_SKIP_VERSION_CHECK=1

# Override Pi install/update telemetry and provider attribution headers.
# Use 1/true/yes to enable or 0/false/no to disable.
# Default: settings.json value / tool default
# PI_TELEMETRY=0

# Set to `long` for extended prompt cache where supported.
# Default: provider/tool default
# PI_CACHE_RETENTION=long

# Show the hardware terminal cursor for IME/candidate-window compatibility.
# Default: unset/disabled
# PI_HARDWARE_CURSOR=1

# Capture raw TUI ANSI output for debugging.
# Default: unset
# PI_TUI_WRITE_LOG=/tmp/pi-tui-ansi.log

# External editor used by Pi for editor handoff shortcuts.
# Default: inherited shell/editor default
# VISUAL="code --wait"
# EDITOR=vim

# Optional override for Gentle AI configuration home.
# Default: tool-defined, normally ~/.pi/gentle-ai
# GENTLE_PI_CONFIG_HOME=/home/ubuntu/.pi/gentle-ai

# ------------------------------------------------------------------------------
# Pi provider API keys
# ------------------------------------------------------------------------------
# Pi can also store credentials via `/login` in ~/.pi/agent/auth.json.
# Auth file credentials take precedence over environment variables.
# Defaults for all API keys: unset

# Anthropic API provider.
# ANTHROPIC_API_KEY=sk-ant-...

# Ant Ling API provider.
# ANT_LING_API_KEY=change-me

# Azure OpenAI Responses API provider.
# AZURE_OPENAI_API_KEY=change-me

# OpenAI API provider.
# OPENAI_API_KEY=sk-...

# DeepSeek API provider.
# DEEPSEEK_API_KEY=change-me

# NVIDIA NIM API provider.
# NVIDIA_API_KEY=change-me

# Google Gemini API provider.
# GEMINI_API_KEY=change-me

# Mistral API provider.
# MISTRAL_API_KEY=change-me

# Groq API provider.
# GROQ_API_KEY=change-me

# Cerebras API provider.
# CEREBRAS_API_KEY=change-me

# Cloudflare AI Gateway / Workers AI API token.
# CLOUDFLARE_API_KEY=change-me

# xAI API provider.
# XAI_API_KEY=change-me

# OpenRouter API provider.
# OPENROUTER_API_KEY=change-me

# Vercel AI Gateway API provider.
# AI_GATEWAY_API_KEY=change-me

# ZAI API provider.
# ZAI_API_KEY=change-me

# ZAI Coding Plan China API provider.
# ZAI_CODING_CN_API_KEY=change-me

# OpenCode Zen / OpenCode Go API providers.
# OPENCODE_API_KEY=change-me

# Hugging Face provider token.
# HF_TOKEN=change-me

# Fireworks API provider.
# FIREWORKS_API_KEY=change-me

# Together AI API provider.
# TOGETHER_API_KEY=change-me

# Kimi For Coding API provider.
# KIMI_API_KEY=change-me

# MiniMax API providers.
# MINIMAX_API_KEY=change-me
# MINIMAX_CN_API_KEY=change-me

# Xiaomi MiMo API providers.
# XIAOMI_API_KEY=change-me
# XIAOMI_TOKEN_PLAN_CN_API_KEY=change-me
# XIAOMI_TOKEN_PLAN_AMS_API_KEY=change-me
# XIAOMI_TOKEN_PLAN_SGP_API_KEY=change-me

# ------------------------------------------------------------------------------
# Pi cloud-provider extras
# ------------------------------------------------------------------------------

# Azure OpenAI endpoint; can be a base URL or a resource name.
# Defaults: unset; API version default is provider/tool-defined when omitted.
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com
# AZURE_OPENAI_RESOURCE_NAME=your-resource
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT_NAME_MAP=gpt-4=my-gpt4,gpt-4o=my-gpt4o

# Amazon Bedrock credentials/options. Standard AWS provider chain also applies.
# Defaults: AWS SDK defaults; AWS_REGION defaults to us-east-1 for Pi examples.
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me
# AWS_BEARER_TOKEN_BEDROCK=change-me
# AWS_REGION=us-east-1
# AWS_BEDROCK_FORCE_CACHE=1
# AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://my.corp.proxy/bedrock
# AWS_BEDROCK_SKIP_AUTH=1
# AWS_BEDROCK_FORCE_HTTP1=1

# Cloudflare provider account/gateway identifiers.
# Defaults: unset
# CLOUDFLARE_ACCOUNT_ID=change-me
# CLOUDFLARE_GATEWAY_ID=change-me

# Google Vertex AI credentials/options.
# Defaults: unset; uses Application Default Credentials when available.
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==============================================================================
# OpenCode installer / runtime
# ==============================================================================

# Set to 1/true/yes to reinstall or update opencode during post-create setup.
# Default: 0; installed versions are preserved on repeated setup runs.
# OPENCODE_AUTO_UPDATE=0

# User-local directory used by the devcontainer opencode installer.
# Default: ~/.local/bin
# OPENCODE_INSTALL_DIR=/home/ubuntu/.local/bin

# Shell profile file updated by the devcontainer opencode installer for PATH setup.
# Default: ~/.bashrc
# OPENCODE_PROFILE_FILE=/home/ubuntu/.bashrc

# Installer endpoint. Override only for mirrors, pinning, or controlled testing.
# Default: https://opencode.ai/install
# OPENCODE_INSTALL_URL=https://opencode.ai/install

# Optional custom OpenCode config paths/content.
# Defaults: OpenCode global/project config discovery
# OPENCODE_CONFIG=/home/ubuntu/.config/opencode/opencode.json
# OPENCODE_CONFIG_DIR=/home/ubuntu/.config/opencode
# OPENCODE_TUI_CONFIG=/home/ubuntu/.config/opencode/tui.json
# OPENCODE_CONFIG_CONTENT={"model":"opencode-go/deepseek-v4-pro"}

# Disable selected OpenCode network/background behaviors for reproducible/offline runs.
# Defaults: unset/disabled
# OPENCODE_DISABLE_AUTOUPDATE=1
# OPENCODE_DISABLE_MODELS_FETCH=1
# OPENCODE_DISABLE_PRUNE=1

# Optional OpenCode behavior toggles.
# Defaults: unset/disabled
# OPENCODE_AUTO_SHARE=1
# OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1
# OPENCODE_DISABLE_AUTOCOMPACT=1
# OPENCODE_DISABLE_CLAUDE_CODE=1

# Basic auth for `opencode serve` / `opencode web`.
# Defaults: username opencode; password unset/disabled
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=change-me

# ==============================================================================
# Playwright
# ==============================================================================

# Playwright package version installed globally during image build.
# Default: 1.60.0
# PLAYWRIGHT_VERSION=1.60.0

# Browser cache/install path used by Playwright.
# Default: /opt/ms-playwright
# PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# ==============================================================================
# Engram local runtime
# ==============================================================================

# Engram CLI version installed during image build.
# Default: 1.16.1
# ENGRAM_VERSION=1.16.1

# Engram data directory. In this starter, ~/.engram is mounted from env/.engram.
# Default: ~/.engram
# ENGRAM_DATA_DIR=/home/ubuntu/.engram

# Engram HTTP API port used by `engram serve`.
# Default: 7437
# ENGRAM_PORT=7437

# Optional Engram HTTP API URL used by clients/integrations when applicable.
# Default: client-defined, commonly http://127.0.0.1:7437
# ENGRAM_URL=http://127.0.0.1:7437

# Process-level default project override for `engram serve`/`engram mcp`.
# Default: auto-detected from cwd when supported
# ENGRAM_PROJECT=gentle-starter

# Optional bearer token for protected local HTTP API routes.
# Default: unset; local HTTP routes are open in zero-config mode
# ENGRAM_HTTP_TOKEN=change-me

# Timezone for timestamp display in Engram TUI/cloud dashboard.
# Default: system local timezone
# ENGRAM_TIMEZONE=America/Mexico_City

# LLM runner used by `engram conflicts scan --semantic`.
# Default: unset
# Allowed examples: claude, opencode
# ENGRAM_AGENT_CLI=opencode

# ==============================================================================
# Engram cloud sync / cloud server (opt-in)
# ==============================================================================

# Set to 1 to enable background cloud autosync.
# Default: unset/disabled
# ENGRAM_CLOUD_AUTOSYNC=1

# Cloud server URL used by autosync and `engram sync --cloud`.
# Default: unset
# ENGRAM_CLOUD_SERVER=https://cloud.engram.example.com

# Bearer token used by cloud sync or required by authenticated cloud serve mode.
# Default: unset
# ENGRAM_CLOUD_TOKEN=change-me

# Postgres DSN for `engram cloud serve`.
# Default: unset
# ENGRAM_DATABASE_URL=postgres://user:password@localhost:5432/engram

# Bind host for `engram cloud serve`.
# Default: 127.0.0.1
# ENGRAM_CLOUD_HOST=127.0.0.1

# Max cloud push payload size in bytes.
# Default: 8388608
# ENGRAM_CLOUD_MAX_PUSH_BYTES=8388608

# Enable local insecure cloud serve mode without auth. Use only for local/dev.
# Default: unset/disabled
# ENGRAM_CLOUD_INSECURE_NO_AUTH=1

# Comma-separated project allowlist for cloud serve; use * for dev/internal all-project access.
# Required by Engram cloud serve in authenticated and insecure modes.
# Default: unset
# ENGRAM_CLOUD_ALLOWED_PROJECTS=gentle-starter

# JWT secret for authenticated cloud serve mode. Must be explicit and non-default.
# Default: unset
# ENGRAM_JWT_SECRET=change-me

# Optional admin-only dashboard token for authenticated cloud serve mode.
# Default: unset
# ENGRAM_CLOUD_ADMIN=change-me

# Optional: GitHub MCP server token. Use a fine-grained token with the minimum required permissions.
GITHUB_PERSONAL_ACCESS_TOKEN=

# ==============================================================================
# SSH server (open to LAN at your own risk)
# ==============================================================================

# SSH public keys for passwordless access to the devcontainer.
# Add one or more keys, one per line. Use \\n to separate multiple keys:
#   SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA...\n ssh-rsa BBBB..."
# To get your public key (on PC B):
#   cat ~/.ssh/id_ed25519.pub
# Default: unset (no pubkey registered; sshd will refuse connections)
# SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA... mi-laptop"
