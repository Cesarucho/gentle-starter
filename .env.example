# Gentleman Starter local environment
#
# Copy this file to `.env` and adjust values for your machine/project:
#
#   cp .env.example .env
#
# `.env` is intentionally ignored by Git. Do not commit secrets or machine-local
# values.

# Timezone used by runtime tools inside the container.
TZ=America/Mexico_City

# Locale used by runtime tools inside the container.
LOCALE=es_MX.UTF-8

# Set to 1/true/yes to run `pi update` during post-create setup.
# Default behavior is to install missing Pi packages without upgrading existing
# ones automatically.
PI_AUTO_UPDATE=0

# Engram version used by the runtime install/update script.
ENGRAM_VERSION=1.16.1

# Optional Playwright browser cache path. Usually you do not need to change this.
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
